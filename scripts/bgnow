#!/usr/bin/env bash
# bgnow — 실행 중인 pi bash 툴 작업을 백그라운드로 전환 (SIGUSR1)
# 사용법: bgnow [jobid]  (미지정 시 가장 최근 실행 중인 작업)
# 다른 tmux 패널 등 pi 밖에서 실행 가능. pi 내부에서는 ctrl+q 단축키가 주 경로.
BG_DIR="/tmp/pi-bg"
latest=""
for d in "$BG_DIR"/*/; do
  [ -d "$d" ] || continue
  [ -e "$d/exit" ] && continue
  jobpid=$(cat "$d/jobpid" 2>/dev/null || echo 0)
  if kill -0 "$jobpid" 2>/dev/null; then
    if [ -z "$latest" ] || [ "$d" -nt "$latest" ]; then latest="$d"; fi
  fi
done
if [ -z "$latest" ]; then echo "bgnow: 실행 중인 작업 없음" >&2; exit 1; fi
latest="${latest%/}"
wp=$(cat "$latest/pid")
kill -USR1 "$wp" && echo "bgnow: 작업 $(basename "$latest") → 백그라운드 전환 (log: $latest/log)"
