{
  "providers": {
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "api": "openai-completions",
      "apiKey": "YOUR_DEEPSEEK_API_KEY",
      "models": [
        {
          "id": "deepseek-chat",
          "name": "DeepSeek V3 / Chat",
          "contextWindow": 64000,
          "maxTokens": 8192,
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cacheRead": 0.014,
            "cacheWrite": 0
          }
        },
        {
          "id": "deepseek-reasoner",
          "name": "DeepSeek R1 / Reasoner",
          "contextWindow": 64000,
          "maxTokens": 8192,
          "reasoning": true,
          "cost": {
            "input": 0.55,
            "output": 2.19,
            "cacheRead": 0.14,
            "cacheWrite": 0
          }
        }
      ]
    },
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "api": "openai-completions",
      "apiKey": "YOUR_OPENAI_API_KEY",
      "models": [
        {
          "id": "gpt-4o",
          "name": "GPT-4o",
          "contextWindow": 128000,
          "maxTokens": 16384,
          "input": [
            "text",
            "image"
          ],
          "cost": {
            "input": 2.50,
            "output": 10.00,
            "cacheRead": 1.25,
            "cacheWrite": 0
          }
        }
      ]
    },
    "opencode-go": {
      "_comment": "Advanced: Optional OpenCode Go Gateway",
      "baseUrl": "http://localhost:8104/v1",
      "api": "openai-completions",
      "apiKey": "local-go-gateway",
      "headers": {
        "X-Client-Id": "pi",
        "X-Project-Id": "pi"
      },
      "models": [
        {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (Go)",
          "contextWindow": 1048576,
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cacheRead": 0.0028,
            "cacheWrite": 0
          }
        },
        {
          "id": "kimi-k3",
          "name": "Kimi K3 (Go)",
          "cost": {
            "input": 3.0,
            "output": 15.0,
            "cacheRead": 0.3,
            "cacheWrite": 0
          }
        }
      ]
    }
  }
}
